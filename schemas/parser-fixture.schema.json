{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokentree.dev/schemas/parser-fixture.schema.json",
  "title": "Sanitized host parser fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "host", "host_version", "scenario", "input", "expected", "sanitization"],
  "properties": {
    "id": { "type": "string" },
    "host": { "type": "string" },
    "host_version": { "type": "string" },
    "scenario": { "type": "string" },
    "input": { "type": "string" },
    "expected": { "type": "string" },
    "sanitization": { "enum": ["synthetic", "irreversibly_redacted"] }
  }
}
