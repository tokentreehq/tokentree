{
  "name": "@tokentreehq/cli",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokentreehq/tokentree.git",
    "directory": "apps/cli"
  },
  "bin": {
    "tokentree": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "migrations",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && tsx scripts/build.ts",
    "typecheck": "tsc -b --pretty false",
    "test:packed-tarball": "bash scripts/test-packed-tarball.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@tokentreehq/core": "workspace:*",
    "@tokentreehq/database": "workspace:*",
    "@tokentreehq/adapter-claude": "workspace:*",
    "@tokentreehq/pricing": "workspace:*"
  }
}
