{
  "name": "tokentree",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
